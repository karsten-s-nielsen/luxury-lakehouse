# Databricks connection — required for dbt and ingestion pipelines.
# Copy this file to .env and fill in your values.
#
# Where to find these values:
#   DATABRICKS_HOST       — Workspace URL without https:// (e.g., dbc-abc123.cloud.databricks.com)
#   DATABRICKS_TOKEN      — Settings > Developer > Access tokens > Generate new token
#   DATABRICKS_HTTP_PATH  — SQL Warehouses > your warehouse > Connection details > HTTP path
#                           IMPORTANT: prefix with double-slash (//sql/...) on Windows/Git Bash
#                           to prevent MSYS path conversion. See CLAUDE.md for details.
#
# How to load:
#   Option 1 (manual):   export $(grep -v '^#' .env | xargs)
#   Option 2 (direnv):   cp .env .envrc && direnv allow
#   Option 3 (IDE):      Configure your IDE's env file support (VS Code: terminal.integrated.env.*)

DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_token_here
DATABRICKS_HTTP_PATH=//sql/1.0/warehouses/your_warehouse_id

# Lakebase (PostgreSQL) — required for the Taipy dashboard app.
# Connection details: Databricks > SQL Warehouses > Lakebase > Connection info
LAKEBASE_HOST=your-lakebase-endpoint.cloud.databricks.com
LAKEBASE_PORT=443
LAKEBASE_USER=your_username
LAKEBASE_PASSWORD=your_password
LAKEBASE_DATABASE=soccer_analytics
LAKEBASE_SCHEMA=dev_gold

# Hugging Face — required for model uploads and HF Jobs.
HF_TOKEN=hf_your_token_here

# AWS — required for Terraform and infrastructure management.
AWS_PROFILE=devops-agent
