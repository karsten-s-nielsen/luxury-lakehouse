# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# Ignore top-level `dist/` (Python wheel build output) but keep webpack-
# built bundles under Taipy GUI extensions — those are the deployed
# artefact and must ship with the repo (see ADR-009).
/dist/
!hf_taipy_app/src/extensions/**/dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# uv
.python-version

# IDE
.idea/
.vscode/

# Claude Code (machine-specific settings)
.claude/
*.swp
*.swo

# Local A/B cycle artefacts (per-arm checkpoints, metrics, dispatch manifests)
artifacts/
*~

# Per-cycle dispatch logs and PIDs at repo root — session droppings only.
# Cycle artefacts worth preserving live alongside the cycle's docs at
# docs/evolve/<cycle>/, not at root (see EV2 cycle for the pattern).
/phase*.log
/phase*.pid
/stage*_retrain.log
/stage*_retrain.pid

# Local scratch directory for mocks, previews, and throwaway experiments.
# Contents are intentionally untracked — nothing here ships.
tmp/

# AC-1 local runner caches (scripts/run_action_context_local.py): pulled bronze
# inputs + enriched result parquets. Untracked — regenerated on demand.
_ac1_cache/
_ac1_local_out/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment variables and secrets
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json

# SK3-MIG orchestrator runtime sidecars (Delta-version rollback + pre-rebuild snapshot)
sk3_mig_pre.json
sk3_mig_rollback.json
sk3_mig_post_report.md

# Terraform
terraform/.terraform/
terraform/**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!terraform/environments/dev/terraform.tfvars.example
tfplan*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# .terraform.lock.hcl is intentionally NOT ignored — committed for reproducible provider versions

# dbt
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
# profiles.yml uses {{ env_var() }} only — no secrets, safe to commit.
# CI depends on it for dbt parse/deps (--profiles-dir .).
dbt_project/.user.yml

# Databricks
.databricks/

# Jupyter
.ipynb_checkpoints/

# Testing
.coverage
htmlcov/
.pytest_cache/

# Ruff
.ruff_cache/

# Large data files (downloaded for UC Volume upload, not committed)
data/

# Build artifacts
*.whl
*.tar.gz

# Working artifacts (not source code)
job_update.json
LUXURY-REVIEW.md
.superpowers/
temp/
results/evolve/

# MLflow run artifacts (per-trial metrics + params; regenerated each Optuna run)
mlruns/

# HTTP cache (requests-cache SQLite database)
luxury_lakehouse_http_cache.sqlite

# Compiled lockfile for the Taipy HF Space — regenerated at deploy time by
# scripts/manage_space.py::_compile_requirements. Committing it creates
# false-positive dependabot-pip PRs for every transitive pin (dependabot
# treats every requirements.txt pin as "direct"), which is unmanageable.
# The Space's build uses the deploy-time generated file; local devs can
# regenerate with: uv pip compile pyproject.toml --extra taipy-app
# --python-version 3.10 --python-platform linux -o hf_taipy_app/requirements.txt
hf_taipy_app/requirements.txt
